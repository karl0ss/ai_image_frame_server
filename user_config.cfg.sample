[frame]
reload_interval = 30000
auto_regen = True
regen_time = 03:00
port = 5000
create_requires_auth = False
# password_for_auth: set it on the settings page and it is stored as a salted hash.
# Plain text and SHA-256 values here still work.
password_for_auth = create

[comfyui]
comfyui_url = http://comfyui
models = zavychromaxl_v100.safetensors,ponyDiffusionV6XL_v6StartWithThisOne.safetensors
output_dir = ./output/
prompt = "Generate a random detailed prompt for stable diffusion."
width = 1568
height = 672
topics =
secondary_topic =

flux = False
qwen = False
zimage = False
only_flux = False

[comfyui:qwen]
models = qwen-image-Q4_K_S.gguf, qwen-image-Q2_K.gguf
[comfyui:zimage]
models = z_image_turbo-Q8_0.gguf
[comfyui:flux]
models = flux1-dev-Q4_0.gguf,flux1-schnell-Q4_0.gguf

[openwebui]
base_url = https://openwebui
api_key = sk-
models = llama3:latest,cogito:14b,gemma3:12b
list_all_models = False

[openrouter]
enabled = False
api_key =
models = mistralai/mistral-7b-instruct:free,google/gemma-7b-it:free,meta-llama/llama-3.1-8b-instruct:free
list_all_free_models = False

[ollama]
enabled = False
api_key =
models = llama3.1,phi3
list_all_cloud_models = False

[freellmapi]
# FreeLLMAPI router, usable for prompts, images, or both.
# enabled turns on prompt generation; image_backend replaces ComfyUI for images.
# As an image backend the router only accepts model="auto" (it picks the provider).
enabled = False
image_backend = False
base_url = http://192.168.4.10:3005
api_key =
# Comma-separated list of chat models to use for prompt generation.
# It must not be empty or the router won't be offered. Use "auto" to let it choose.
models = auto

[local_llm]
# Unloaded from the GPU before every ComfyUI render. Leave a URL blank to skip that server.
llama_swap_url =
ollama_url =
# Comma-separated models to leave running, such as CPU-only ones.
keep_loaded =

[remote]
# Optionally start the ComfyUI service before generating and stop it after.
# Service is started/stopped over SSH on `host` via `sudo systemctl`.
enabled = False
host = 192.168.4.102
port = 22
username = karl
password =
service = comfyui
# Wait (seconds) for the service to start listening before generating.
startup_poll_timeout = 90
